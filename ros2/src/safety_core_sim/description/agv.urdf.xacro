<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="safety_core_agv">

  <!-- ========================================================
       Properties (industrial AGV-class footprint)
  ======================================================== -->
  <xacro:property name="base_length"     value="0.80"/>
  <xacro:property name="base_width"      value="0.60"/>
  <xacro:property name="base_height"     value="0.20"/>
  <xacro:property name="base_mass"       value="40.0"/>

  <xacro:property name="wheel_radius"    value="0.10"/>
  <xacro:property name="wheel_length"    value="0.05"/>
  <xacro:property name="wheel_separation" value="0.50"/>
  <xacro:property name="wheel_mass"      value="3.0"/>

  <xacro:property name="caster_radius"   value="0.04"/>

  <xacro:property name="lidar_height"    value="0.06"/>
  <xacro:property name="lidar_x_offset"  value="${base_length/2.0 - 0.05}"/>

  <!-- ========================================================
       Inertia macros
  ======================================================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(1.0/12.0)*m*(y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0)*m*(x*x + z*z)}" iyz="0.0"
        izz="${(1.0/12.0)*m*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(1.0/12.0)*m*(3.0*r*r + l*l)}" ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0)*m*(3.0*r*r + l*l)}" iyz="0.0"
        izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${0.4*m*r*r}" ixy="0.0" ixz="0.0"
        iyy="${0.4*m*r*r}" iyz="0.0"
        izz="${0.4*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================================
       Footprint frame (REP-105) — projection onto ground plane
  ======================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================
       Chassis
  ======================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="agv_yellow"><color rgba="0.95 0.75 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- Gazebo material properties for base -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <!-- ========================================================
       Drive wheels (left + right)
  ======================================================== -->
  <xacro:macro name="drive_wheel" params="prefix y_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
        <material name="rubber_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_sign*wheel_separation/2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_sign="1.0"/>
  <xacro:drive_wheel prefix="right" y_sign="-1.0"/>

  <!-- Gazebo material properties for wheels -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
    <fdir1>0 1 0</fdir1>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
    <fdir1>0 1 0</fdir1>
  </gazebo>

  <!-- ========================================================
       Caster (front + rear) for stability
  ======================================================== -->
  <xacro:macro name="caster" params="prefix x_sign">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="rubber_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.5" r="${caster_radius}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x_sign*(base_length/2.0 - caster_radius)} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:caster prefix="front" x_sign="1.0"/>
  <xacro:caster prefix="rear"  x_sign="-1.0"/>

  <!-- Gazebo material properties for casters -->
  <gazebo reference="front_caster_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <gazebo reference="rear_caster_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <!-- ========================================================
       Lidar (planar, forward-mounted)
  ======================================================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="lidar_blue"><color rgba="0.05 0.4 0.85 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="0.04" l="0.05"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x_offset} 0 ${base_height + lidar_height}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================
       IMU (centered on base)
  ======================================================== -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <material name="imu_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================
       GPS (antenna on top of robot for localization)
  ======================================================== -->
  <link name="gps_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.02"/></geometry>
      <material name="gps_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.02"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.08" y="0.08" z="0.02"/>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="${lidar_x_offset} 0.05 ${base_height + 0.25}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================
       Camera (forward-facing for visualization)
  ======================================================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="camera_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.04" y="0.04" z="0.04"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${lidar_x_offset} 0 ${base_height + 0.15}" rpy="0 0.3 0"/>
  </joint>

  <!-- ========================================================
       Gazebo plugins (Harmonic / gz-sim 8)
  ======================================================== -->

  <!-- Differential drive plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_wheel_torque>5.0</min_wheel_torque>
      <max_wheel_torque>20.0</max_wheel_torque>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <enable_ros2_control>false</enable_ros2_control>
    </plugin>
  </gazebo>

  <!-- Joint state publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Lidar sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- GPS sensor -->
  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <pose>0 0 0 0 0 0</pose>
      <topic>/gps</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <navsat>
        <position_reference_frame_id>world</position_reference_frame_id>
        <velocity_reference_frame_id>world</velocity_reference_frame_id>
      </navsat>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>1.0</stddev>
      </noise>
    </sensor>
  </gazebo>

</robot>
