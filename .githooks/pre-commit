#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

clang_format="${CLANG_FORMAT:-clang-format}"
clang_tidy="${CLANG_TIDY:-clang-tidy}"
build_dir="${BUILD_DIR:-build}"
auto_fix_format="${AUTO_FIX_FORMAT:-1}"
skip_clang_tidy="${SKIP_CLANG_TIDY:-0}"

fmt_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.cpp' '*.cc' '*.cxx' '*.hpp' '*.h' '*.hh' '*.hxx')

# Nothing to check
if [ -z "$fmt_files" ]; then
    exit 0
fi

# Check if clang-format is available, try to use docker if not
if ! command -v "$clang_format" >/dev/null 2>&1; then
    # Check if docker-compose is available and there's a docker-compose.yml
    if command -v docker-compose >/dev/null 2>&1 && [ -f "$ROOT/docker-compose.yml" ]; then
        # Use docker to run clang-format
        echo "clang-format not found on host, using docker..."
        clang_format_cmd="docker exec safety-autonomy-demo clang-format"
    else
        echo "ERROR: clang-format not found (override with CLANG_FORMAT)" >&2
        echo "Install with: sudo apt install clang-format" >&2
        exit 1
    fi
else
    clang_format_cmd="$clang_format"
fi
if [ "$auto_fix_format" = "1" ]; then
    echo "Running clang-format auto-fix on staged files..."
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        # Convert path for docker if needed
        if [[ "$clang_format_cmd" == docker* ]]; then
            docker_file="/workspace/safety-autonomy-core/$file"
        else
            docker_file="$file"
        fi
        $clang_format_cmd -i "$docker_file"
        git add "$file"
    done <<< "$fmt_files"
else
    echo "Running clang-format check on staged files..."
    # Convert paths for docker if needed
    if [[ "$clang_format_cmd" == docker* ]]; then
        docker_files=$(echo "$fmt_files" | sed 's|^|/workspace/safety-autonomy-core/|')
        echo "$docker_files" | xargs -r $clang_format_cmd --dry-run --Werror
    else
        echo "$fmt_files" | xargs -r $clang_format_cmd --dry-run --Werror
    fi
fi

cpp_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.cpp' '*.cc' '*.cxx')
if [ "$skip_clang_tidy" = "1" ]; then
    echo "Skipping clang-tidy because SKIP_CLANG_TIDY=1"
elif [ -n "$cpp_files" ]; then
    if ! command -v "$clang_tidy" >/dev/null 2>&1; then
        echo "ERROR: clang-tidy not found (override with CLANG_TIDY or set SKIP_CLANG_TIDY=1)" >&2
        exit 1
    fi

    build_path="$ROOT/$build_dir"
    if [ ! -f "$build_path/compile_commands.json" ]; then
        echo "ERROR: $build_path/compile_commands.json is missing; generate it with:" >&2
        echo "  cmake -S . -B $build_dir -DCMAKE_EXPORT_COMPILE_COMMANDS=ON" >&2
        exit 1
    fi

    echo "Running clang-tidy on staged C++ sources..."
    echo "$cpp_files" | xargs -r "$clang_tidy" --quiet -p "$build_path"
else
    echo "No staged C++ sources for clang-tidy; skipping"
fi

exit 0
